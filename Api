# -------------------------
# MOVE ROBOT
# -------------------------
@app.post("/move")
def move_robot(target_x: float, target_y: float):
    try:
        res = requests.post(
            f"{ROBOT_HTTP}/chassis/move",
            json={"target_x": target_x, "target_y": target_y},
            timeout=5
        )
        return res.json()
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


