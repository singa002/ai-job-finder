from fastapi import FastAPI, HTTPException
import requests

app = FastAPI()

ROBOT_HTTP = "http://166.147.161.155:8080"

# -------------------------
# GET MAP
# -------------------------
@app.get("/map")
def get_map():
    try:
        res = requests.get(f"{ROBOT_HTTP}/map", timeout=5)
        return res.json()
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


